# Get your token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Cloudflare R2 public bucket URL (leave empty to serve from local public/ folder)
# Example: https://pub-abc123.r2.dev
VITE_R2_URL=

# R2 write access, used only by scripts/r2-upload.js and scripts/r2-delete.js.
# NOT prefixed with VITE_ — never exposed to the browser bundle.
# Create at Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
# (permission: Object Read & Write, scoped to this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email subscriptions (Resend). NOT prefixed with VITE_ — never exposed to
# the browser bundle. Get an API key at https://resend.com/api-keys.
# RESEND_SEGMENT_ID: create a Segment at https://resend.com/audience and
# paste its id here — new subscribers are added to it, and
# scripts/notify-subscribers.js sends broadcasts to it. Used by api/subscribe.js
# (set these in the Vercel project's env vars) and by
# .github/workflows/notify-subscribers.yml (set these as GitHub repo secrets).
RESEND_API_KEY=
RESEND_SEGMENT_ID=
# Must be an address on a domain verified in Resend, e.g. "Tyler's Treks <updates@tylers-treks.com>"
RESEND_FROM_EMAIL=

# Used by scripts/generate-rss.js and scripts/notify-subscribers.js to build
# absolute links. Defaults to the production URL if unset.
SITE_URL=
