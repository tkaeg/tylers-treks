# Get your token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Cloudflare R2 public bucket URL (leave empty to serve from local public/ folder)
# Example: https://pub-abc123.r2.dev
VITE_R2_URL=

# R2 write access, used only by scripts/r2-upload.js and scripts/r2-delete.js.
# NOT prefixed with VITE_ — never exposed to the browser bundle.
# Create at Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
# (permission: Object Read & Write, scoped to this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
